<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>每日英语背诵模块</title>
<style>
:root{
 --bg:#0f1115; --card:#181b22; --card2:#1e222b; --ink:#e9edf2; --sub:#8b93a1;
 --line:#2a2f3a; --brand:#4f8cff; --brand2:#6ee7b7; --accent:#3fd6ab;
 --l1:#94a3b8; --l2:#60a5fa; --l3:#fbbf24; --l4:#34d399; --l5:#c084fc;
 --warn:#f59e0b;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;padding:0}
body{
 background:var(--bg);color:var(--ink);
 font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Hiragino Sans GB","Microsoft YaHei",sans-serif;
 font-size:15px;line-height:1.6;padding-bottom:30px;
}
.wrap{max-width:860px;margin:0 auto;padding:16px}
button{font-family:inherit;cursor:pointer;border:none;background:none;color:inherit}
.card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:16px 18px;margin-bottom:14px}
.card-h{display:flex;align-items:center;gap:8px;font-weight:700;font-size:15px;margin-bottom:12px}
.card-h .ic{font-size:16px}
.ch-act{margin-left:auto;display:flex;gap:6px;align-items:center}
.back{font-size:13px;color:var(--sub);cursor:pointer;margin-bottom:12px;display:inline-block;padding:6px 0}
.back:hover{color:var(--ink)}
.empty{color:var(--sub);font-size:13.5px;text-align:center;padding:20px 0}
footer{text-align:center;color:var(--sub);font-size:11.5px;padding:20px 0;letter-spacing:.6px}

/* 英语模块样式 */
.en-card{border-color:rgba(79,140,255,.35);background:linear-gradient(135deg,#141c2e,#0f1a2b)}
.en-card .card-h .ic{background:linear-gradient(135deg,#3fd6ab,#7c9bff);box-shadow:0 4px 12px rgba(63,214,171,.3);border-radius:8px;width:26px;height:26px;display:flex;align-items:center;justify-content:center;color:#fff}
.en-hero-top{font-size:12.5px;font-weight:700;color:var(--brand2);letter-spacing:.5px;margin-bottom:8px;display:flex;align-items:center;gap:6px}
.en-hero-top .dot{width:7px;height:7px;border-radius:50%;background:var(--brand2);display:inline-block;box-shadow:0 0 8px var(--brand2)}
.en-mini{display:flex;gap:14px;align-items:stretch;flex-wrap:wrap}
.en-mini .en-body{flex:1;min-width:200px}
.en-mini .en-name{font-size:16px;font-weight:700;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.en-mini .en-meta{font-size:12.5px;color:var(--sub);margin-top:8px;line-height:1.7}
.en-mini .en-act{flex-shrink:0;display:flex;align-items:center}
.en-mini .en-act button{padding:12px 24px;font-size:15px;border-radius:14px;background:linear-gradient(135deg,var(--brand),var(--brand2));color:#062b1f;font-weight:700}
.en-marks{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px;align-items:center}
.en-marks button{padding:8px 14px;font-size:12.5px;border-radius:10px;border:1px solid var(--line);background:rgba(255,255,255,.04);color:var(--ink)}
.en-list{display:flex;flex-direction:column;gap:10px}
.en-item{background:var(--card2);border:1px solid var(--line);border-radius:14px;padding:14px;cursor:pointer;display:flex;gap:12px;align-items:center}
.en-item:active{transform:scale(.99)}
.en-item .no{width:26px;height:26px;border-radius:8px;background:rgba(79,140,255,.15);color:var(--brand);font-weight:700;font-size:12.5px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.en-item .mid{flex:1;min-width:0}
.en-item .mn{font-weight:600;font-size:14px}
.en-item .mg{font-size:11.5px;color:var(--sub);margin-top:3px}
.en-item .st{font-size:11px;padding:2px 8px;border-radius:20px;flex-shrink:0}
.st.s0{background:rgba(148,163,184,.12);color:var(--l1)}
.st.s1{background:rgba(248,113,113,.14);color:#f87171}
.st.s2{background:rgba(251,191,36,.14);color:var(--l3)}
.st.s3{background:rgba(96,165,250,.14);color:var(--l2)}
.st.s4{background:rgba(52,211,153,.14);color:var(--l4)}
.st.due{background:rgba(245,158,11,.18);color:var(--warn)}
.en-item .arw{color:var(--sub);font-size:13px;flex-shrink:0}
.en-group-h{font-size:15px;font-weight:700;margin-bottom:12px;display:flex;align-items:center;gap:8px}
.g-cnt{font-size:11.5px;color:var(--sub);font-weight:400}
.tag{display:inline-block;padding:2px 8px;border-radius:20px;font-size:11px;font-weight:600}
.tag.ts{background:rgba(79,140,255,.15);color:var(--brand)}
.tag.td{background:rgba(110,231,183,.15);color:var(--brand2)}
.tag.tm{background:rgba(52,211,153,.15);color:var(--l4)}
.tag.to{background:rgba(148,163,184,.12);color:var(--l1)}
.en-box{background:var(--card2);border:1px solid var(--line);border-radius:12px;padding:14px;margin-bottom:12px}
.en-box .lbl{display:block;font-size:11.5px;color:var(--sub);font-weight:700;letter-spacing:.5px;margin-bottom:8px;text-transform:uppercase}
.en-box.warn{border-color:rgba(245,158,11,.35);background:rgba(245,158,11,.07)}
.en-box.warn .lbl{color:var(--warn)}
.en-vocab{margin:0;padding-left:0;list-style:none}
.en-vocab li{margin-bottom:7px;padding-left:4px;font-size:13.5px;line-height:1.7}
.en-prompt{border-left:3px solid var(--brand2);padding:12px 14px;margin:14px 0;background:rgba(110,231,183,.06);border-radius:0 10px 10px 0}
.en-prompt .lbl{display:block;font-size:11.5px;color:var(--brand2);font-weight:700;margin-bottom:6px}
.en-prompt p{margin:0;font-size:14px;line-height:1.8}
.rate-btns{display:flex;gap:8px;flex-wrap:wrap}
.rate-btns button{flex:1;min-width:90px;padding:12px 6px;border-radius:12px;border:1px solid var(--line);font-size:13px;font-weight:600;text-align:center;background:rgba(255,255,255,.04)}
.rate-btns .b2{background:rgba(251,191,36,.14);border-color:rgba(251,191,36,.4)}
.rate-btns .b4{background:rgba(52,211,153,.14);border-color:rgba(52,211,153,.4)}
.note-box{width:100%;background:var(--card2);border:1px solid var(--line);border-radius:12px;padding:11px;color:var(--ink);font-size:14px;resize:vertical;min-height:70px}
.note-list{margin-top:10px}
.nl-item{display:flex;gap:10px;padding:8px 0;border-bottom:1px dashed var(--line);font-size:13px}
.nl-item:last-child{border-bottom:none}
.nl-date{font-family:monospace;font-size:12px;color:var(--sub);min-width:92px;flex-shrink:0}
.nl-text{flex:1;color:var(--ink);line-height:1.65}
.toast{position:fixed;left:50%;bottom:40px;transform:translateX(-50%);background:#11151c;border:1px solid var(--line);color:var(--ink);padding:10px 18px;border-radius:12px;font-size:13.5px;z-index:200;opacity:0;transition:.25s;pointer-events:none}
.toast.on{opacity:1}
.ph{color:var(--brand2);font-weight:600;background:rgba(110,231,183,.08);padding:1px 4px;border-radius:4px}
#toast{transition:opacity .25s}
</style>
</head>
<body>
<div class="wrap" id="app"></div>
<div class="toast" id="toast"></div>

<script>
/* =========================================================
   每日英语背诵模块 · 17 片数据（全部内联，无需服务器）
   ========================================================= */
var EN_DATA = [
 {order:1, group:"A-模板", key:"P1-图画", name:"图画类 P1 首段",
  content:"Presented before us is a thought-provoking scene in which [画面主体及动作]. What makes the picture particularly striking is that [关键细节或对比]. Simple as the picture may seem, it conveys a meaningful message about [主题].",
  memory:"记忆顺序：画面主体 → 关键细节 → 核心寓意",
  notes:"主语是 Several villagers 时谓语用 are；是 A group of villagers 时谓语用 is。主题不要只写宽泛名词，尽量明确到 the inheritance of traditional culture、the importance of perseverance 这类具体表达。",
  prompt:"用中文描述一个「祖孙三代各自低头看手机」的画面，按 画面主体→关键细节→核心寓意 的顺序写三句英文。"},

 {order:2, group:"A-模板", key:"P1-动态图", name:"动态图 / 表格类 P1 首段",
  content:"The [table/line graph/bar chart] illustrates how [主题] changed from [起始年份] to [结束年份]. During this period, [A] experienced a noticeable [rise/fall], while [B] showed [a similar trend/an opposite trend]. Taken together, the figures reveal a clear change in [主题或社会意义].",
  memory:"记忆顺序：材料类型与时间 → 主要变化 → 数据反映的意义",
  notes:"材料类型必须准确：表格 table、折线图 line graph、柱状图 bar chart。数据较多时优先突出主要趋势，不要机械罗列所有数字。",
  prompt:"用中文给出「2015—2025 某产品销量」的上升数据，写三句英文描述趋势。"},

 {order:3, group:"A-模板", key:"P1-静态图", name:"静态图 P1 首段",
  content:"The chart presents the distribution of [调查主题]. Specifically, [A] accounts for the largest proportion, at [数字]%. By contrast, [B] represents the smallest share, at only [数字]%. This striking difference reflects a broader change in our society.",
  memory:"记忆顺序：调查主题 → 最大比例 → 最小比例 → 社会意义",
  notes:"chart 是统称；具体是饼图可换成 pie chart。若题目并非比例分布而是人数或频率比较，要调整 proportion/share，不能强行套用。",
  prompt:"用中文给出「各年龄段日均阅读时长」的比例，写三句英文描述。"},

 {order:4, group:"A-模板", key:"P1-混合", name:"图画 + 图表混合类 P1 首段",
  content:"The two forms of information jointly illustrate the current situation of [主题]. As shown in the picture, [画面内容]. Meanwhile, the chart indicates that [主要数据或趋势]. Although presented in different forms, they point to the same meaningful change in our society.",
  memory:"记忆顺序：总主题 → 图片内容 → 图表信息 → 共同寓意",
  notes:"若材料包含图片与图表两种信息，要兼顾两者，不能只写其一。",
  prompt:"用中文给出「一张反映环保行为的图片 + 一张垃圾分类比例图」，写四句英文。"},

 {order:5, group:"A-模板", key:"P1-文字", name:"文字类 P1 首段",
  content:"The provided statement presents a thought-provoking view that [改写原文观点]. It highlights the importance of [主题] in our daily lives and social development. Personally, I strongly agree with this idea, as it is highly relevant to our present society.",
  memory:"记忆顺序：改写观点 → 强调价值 → 表明立场",
  notes:"若原文观点存在争议，或题目要求评价而非赞同，不要机械用 I strongly agree，应根据题目调整立场。",
  prompt:"用中文给出一句待评价的观点，改写并表明立场，写三句英文。"},

 {order:6, group:"A-模板", key:"P2-正面", name:"通用 P2 正面论证",
  content:"There are several interconnected reasons why this phenomenon deserves our attention. To begin with, [主题] can bring considerable benefits to individuals by enabling them to [作用一]. Moreover, [第二个原因或社会条件] has created more favorable conditions for [主题或趋势]. More importantly, this phenomenon reflects not merely a change in behavior, but a broader transformation in people's attitudes toward [主题].",
  table:"句子 | 功能 | 考场上需要填什么\nThere are several... | 总起 | 引出分析\nTo begin with... | 第一层 | 个人作用或直接影响\nMoreover... | 第二层 | 社会条件、科技、经济、观念等\nMore importantly... | 深层意义 | 价值观、生活方式、社会变化",
  notes:"四句功能必须记清楚：总起 / 第一层 / 第二层 / 深层意义。",
  prompt:"用正面论证写一句「阅读让人成长」，套用 To begin with 和 Moreover 两层。"},

 {order:7, group:"A-模板", key:"P2-负面", name:"通用 P2 负面论证（替换版）",
  content:"There are several interconnected reasons why this phenomenon deserves our attention. To begin with, excessive [行为或现象] may prevent individuals from [负面影响一]. Moreover, [相关原因或社会条件] may further aggravate this problem. More importantly, this phenomenon reflects not merely a change in behavior, but a broader problem in people's attitudes toward [主题].",
  notes:"正面题强调 benefits、opportunities、development；负面题强调 risks、problems、negative effects。第三句原因必须符合题意，不能为了套模板凭空认定某种社会条件加剧了问题。",
  prompt:"用负面论证写「过度依赖网络」的危害，套用 To begin with 和 Moreover 两层。"},

 {order:8, group:"A-模板", key:"P3", name:"通用 P3 第三段",
  content:"In light of the above, [主题或现象] deserves our thoughtful attention. As individuals, we should enhance our awareness of [主题] and translate it into concrete actions in our daily lives. Meanwhile, relevant institutions should take effective measures to create a more favorable environment for [目标]. With the joint efforts of individuals and society, we can better [目标或解决的问题] and build a more promising future.",
  rule:"总结：In light of the above...｜个人行动：As individuals...｜社会/机构：Meanwhile, relevant institutions...｜展望：With the joint efforts...",
  notes:"不是每题都必须写政府。若侧重个人习惯、成长或日常选择，可把 relevant institutions 换成更贴切的社会主体，或写家庭、学校、社区。",
  prompt:"围绕「环境保护」收尾，用 As individuals 和 With the joint efforts 两层收束。"},

 {order:9, group:"A-模板", key:"图表-趋势", name:"图表专用：动态图趋势表达",
  content:"严格背诵句：During this period, [A] experienced a noticeable rise from [数字] to [数字], while [B] showed a similar upward trend. / Taken together, the figures reveal a clear change in [主题].",
  vocab:["rise significantly 显著上升","increase steadily 稳步增长","decline sharply 大幅下降","decrease slightly 略有下降","remain stable 保持稳定","fluctuate 出现波动","reach a peak of 达到最高点","rise from A to B 从A上升至B","show an upward trend 呈现上升趋势","show an opposite trend 呈现相反趋势"],
  notes:"Taken together 句只在图表题用，不要塞进图画、文字类作文。",
  prompt:"用中文给出两组数据的一升一降，写两句英文描述趋势。"},

 {order:10, group:"A-模板", key:"图表-比例", name:"图表专用：静态图比例与对比",
  content:"严格背诵句：Specifically, [A] accounts for the largest proportion, at [数字]%. By contrast, [B] represents the smallest share, at only [数字]%. This striking difference reflects a broader change in our society.",
  vocab:["account for the largest proportion 占最大比例","represent the smallest share 占最小比例","account for ... percent 占…百分比","By contrast, 相比之下","a striking difference 明显差异","distribution 分布情况","survey results 调查结果"],
  notes:"数据单位是「每百户拥有量」时不能误写成百分比；只有真正表示比例时才能用 %、proportion 或 share。",
  prompt:"用中文给出最大占比与最小占比两组数据，写三句英文描述。"},

 {order:11, group:"B-语料", key:"语料-个人成长", name:"个人成长与优秀品质",
  content:"适用主题：坚持、自律、勤奋、责任感、面对困难、青年成长",
  vocab:["develop self-discipline 培养自律","strengthen one's sense of responsibility 增强责任感","cope with difficulties in life 应对生活中的困难","deal with pressure more effectively 更有效地应对压力","improve one's problem-solving skills 提升解决问题的能力","stand out in a competitive environment 在竞争激烈的环境中脱颖而出","lay a solid foundation for the future 为未来打下坚实基础","persistent effort 坚持不懈的努力","personal growth 个人成长","fulfill one's potential 实现个人潜能"],
  plug:"To begin with, perseverance can bring considerable benefits to individuals by enabling them to cope with difficulties more effectively. Moreover, developing self-discipline helps young people lay a solid foundation for the future.",
  prompt:"用中文给出「坚持与自律」的语境，用这组语料套进 P2 写两句。"},

 {order:12, group:"B-语料", key:"语料-传统文化", name:"传统文化与文化传承",
  content:"适用主题：传统节日、龙舟赛、非物质文化遗产、文化认同、文化传播",
  vocab:["preserve traditional culture 传承传统文化","promote traditional culture 弘扬传统文化","protect cultural heritage 保护文化遗产","deepen one's understanding of national history 加深对本国历史的了解","strengthen cultural identity 增强文化认同","connect different generations 连接不同世代","give traditional culture new life 让传统文化焕发新的活力","continue to thrive in modern society 在现代社会中延续","cultural diversity 文化多样性","pass down from generation to generation 代代相传"],
  plug:"To begin with, traditional cultural activities enable people to deepen their understanding of national history and strengthen cultural identity. More importantly, the preservation of traditional culture reflects a broader recognition of the value of our cultural heritage.",
  prompt:"用中文给出「端午节龙舟赛」的语境，用这组语料套进 P2 写两句。"},

 {order:13, group:"B-语料", key:"语料-科技数字", name:"科技与数字生活",
  content:"适用主题：智能手机、互联网、人工智能、数字技术、科技便利与风险",
  vocab:["the rapid development of technology 科技的快速发展","the widespread use of the Internet and smartphones 广泛使用互联网和智能手机","provide greater convenience 提供更大的便利","improve work efficiency 提高工作效率","access information 获取信息","broaden one's horizons 拓宽知识面","excessive reliance on digital devices 过度依赖数字设备","reduce face-to-face interaction 减少面对面交流","protect personal privacy 保护个人隐私","make responsible use of technology 合理使用科技"],
  plug:"正面：To begin with, digital technology can bring considerable benefits to individuals by enabling them to access information more efficiently. 负面：To begin with, excessive reliance on digital devices may reduce face-to-face interaction and weaken personal relationships.",
  notes:"数字生活题材：优先科技因素；若是负面题，重点写过度依赖造成的影响。",
  prompt:"用中文给出「智能手机」语境，分别写一句正面、一句负面的论证。"},

 {order:14, group:"B-语料", key:"语料-经济发展", name:"经济发展与消费升级",
  content:"适用主题：耐用消费品表格、生活水平、家用电器、消费方式变化",
  vocab:["the rapid development of the economy 经济的快速发展","disposable income 可支配收入","an improvement in living standards 生活水平提高","material living conditions 物质生活条件","a more comfortable life 更舒适的生活","a more convenient lifestyle 更便利的生活方式","consumption upgrading 消费升级","household appliances 家用电器","improve the quality of life 提高生活质量","responsible consumption 理性消费","a green and energy-efficient lifestyle 绿色、节能的生活方式","balance consumption with environmental responsibility 兼顾消费与环境责任"],
  plug:"To begin with, the growing ownership of household appliances enables people to enjoy a more convenient and comfortable life. Moreover, rising disposable income has created more favorable conditions for consumption upgrading.",
  prompt:"用中文给出「家用电器普及」的语境，用这组语料套进 P2 写两句。"},

 {order:15, group:"B-语料", key:"语料-环保", name:"环境保护与可持续发展",
  content:"适用主题：环保、低碳生活、资源浪费、绿色消费、可持续发展",
  vocab:["environmental protection 环境保护","environmental pollution 环境污染","conserve natural resources 节约自然资源","reduce unnecessary waste 减少不必要的浪费","take environmentally friendly measures 采取环保措施","raise environmental awareness 提高环保意识","sustainable development 可持续发展","protect the interests of future generations 保护子孙后代的利益","a green lifestyle 绿色生活方式","joint efforts 共同努力"],
  plug:"As individuals, we should raise our environmental awareness and translate it into concrete actions in our daily lives. With the joint efforts of individuals and society, we can promote sustainable development and build a more promising future.",
  notes:"环保题材优先观念变化、个人责任、社会措施。",
  prompt:"用中文给出「减少一次性塑料」的语境，用这组语料套进 P3 写两句。"},

 {order:16, group:"B-语料", key:"语料-教育阅读", name:"教育、阅读与知识积累",
  content:"适用主题：阅读习惯、终身学习、教育价值、知识积累、个人发展",
  vocab:["develop a reading habit 培养阅读习惯","accumulate knowledge 积累知识","broaden one's horizons 拓宽视野","develop independent thinking 培养独立思考能力","stimulate creativity 激发创造力","lifelong learning 终身学习","acquire new knowledge 获取新知识","improve overall abilities 提高综合能力","prepare for future development 为未来发展做好准备","develop a positive attitude toward learning 形成积极的学习态度"],
  plug:"To begin with, reading can bring considerable benefits to individuals by enabling them to accumulate knowledge and broaden their horizons. More importantly, a commitment to lifelong learning reflects a positive attitude toward personal growth.",
  prompt:"用中文给出「终身阅读」的语境，用这组语料套进 P2 写两句。"},

 {order:17, group:"B-语料", key:"语料-通用原因", name:"通用原因句（六类宏观分析）",
  content:"语料是备用零件，不是每篇作文都要全部使用。",
  vocab:["经济因素：With the rapid development of the economy, people's disposable income has increased, creating more opportunities for [主题或行为].","科技因素：Advances in technology have made it easier for people to [具体行为], thereby increasing its popularity.","生活方式：As the pace of modern life continues to accelerate, people are paying greater attention to [需求或主题].","观念变化：People have become increasingly aware of the importance of [主题], which has encouraged them to [具体行为].","社会条件：The development of modern society has created more favorable conditions for [主题或趋势].","个人收益：By enabling people to [具体作用], [主题或行为] can contribute to their personal growth and overall well-being."],
  rule:"消费品拥有量上升：优先经济、科技因素｜阅读或学习：优先观念变化、个人收益｜传统文化：优先文化认同、社会条件｜数字生活：优先科技因素，负面题重点写过度依赖的影响｜环保：优先观念变化、个人责任、社会措施。不要把「经济发展」硬套进每一道题。",
  prompt:"用中文给出「为何人们越来越重视健康生活」的语境，挑选合适的宏观原因句写一句。"}
];

/* =========================================================
   状态 & 配置
   ========================================================= */
var EN_KEY = 'kb_english_progress_v1';
var EN_LVL = {1:'遗忘',2:'模糊',3:'有点印象',4:'能默写',5:'应用通过'};
var EN_NODES = [1,2,4,7,15];
var progress = {reviews:{}, notes:{}, firstDates:{}, lastDates:{}};

function todayStr(){var d=new Date();return d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate());}
function pad(n){return n<10?'0'+n:''+n;}
function daysBetween(a,b){
 var x=new Date(a);x.setHours(0,0,0,0);
 var y=new Date(b);y.setHours(0,0,0,0);
 return Math.round((y-x)/86400000);
}
function addDays(s,n){var x=new Date(s);x.setDate(x.getDate()+n);return x.getFullYear()+'-'+pad(x.getMonth()+1)+'-'+pad(x.getDate());}
function esc(s){return String(s==null?'':s).replace(/&/g,'&amp;').replace(/<'/g,'&lt;').replace(/>/g,'&gt;');}

/* 本地持久化 */
function loadProgress(){
 try{
  var raw = localStorage.getItem(EN_KEY);
  if(raw){progress = JSON.parse(raw);}
 }catch(e){}
}
function saveProgress(){
 try{localStorage.setItem(EN_KEY, JSON.stringify(progress));}catch(e){}
}

/* 复习记录 */
function reviewsOf(order){
 var out = [];
 Object.keys(progress.reviews).forEach(function(k){
  if(k.split('|')[0] === String(order)) out.push(progress.reviews[k]);
 });
 return out.sort(function(a,b){return a.date.localeCompare(b.date);});
}
function lastLevel(order){
 var rs = reviewsOf(order);
 return rs.length ? rs[rs.length-1].level : 0;
}
function lastDate(order){
 var rs = reviewsOf(order);
 return rs.length ? rs[rs.length-1].date : null;
}
function firstDate(order){
 return progress.firstDates[order] || null;
}
function isDue(order){
 var rs = reviewsOf(order);
 if(!rs.length) return true; // 未首背，优先派
 var d = lastDate(order);
 var gap = daysBetween(d, todayStr());
 if(gap < 0) return false;
 if(gap === 0) return true;
 var lvl = lastLevel(order);
 var next = (lvl>=4) ? 7 : enGapAfter(d, firstDate(order));
 return gap >= next;
}
function enGapAfter(last,first){
 var past = daysBetween(first, last);
 var seq = [0].concat(EN_NODES);
 for(var i=0;i<seq.length;i++){if(seq[i]===past) return (seq[i+1]!==undefined ? seq[i+1]-past : 15);}
 return 15;
}
function pickToday(){
 var cand = EN_DATA.slice().sort(function(a,b){return a.order-b.order;});
 var due=[], fresh=[];
 cand.forEach(function(d){
  if(!firstDate(d.order)){due.push(d);return;}
  if(isDue(d.order)) due.push(d);
  else fresh.push(d);
 });
 if(due.length) return due[0];
 return fresh[0] || cand[0];
}

/* 自评记录 */
function markLevel(order, level){
 var t = todayStr();
 var rs = reviewsOf(order);
 // 同一天同一片只保留一条（更新）
 var key = null;
 Object.keys(progress.reviews).forEach(function(k){
  var parts = k.split('|');
  if(parts[0]===String(order) && parts[1]===t) key = k;
 });
 if(key){
  progress.reviews[key].level = level;
 }else{
  progress.reviews[order+'|'+t] = {order:order, date:t, level:level};
 }
 if(!firstDate(order)) progress.firstDates[order] = t;
 progress.lastDates[order] = t;
 saveProgress();
}

/* 卡点备注 */
function getNote(order){
 return (progress.notes && progress.notes[order]) || '';
}
function setNote(order, val){
 if(!progress.notes) progress.notes = {};
 if(val && val.trim()) progress.notes[order] = val.trim();
 else delete progress.notes[order];
 saveProgress();
}

/* =========================================================
   渲染
   ========================================================= */
var view = 'home';
var curOrder = null;
var toastTimer = null;

function toast(m){
 var t = document.getElementById('toast');
 t.textContent = m;
 t.classList.add('on');
 clearTimeout(toastTimer);
 toastTimer = setTimeout(function(){t.classList.remove('on');}, 1800);
}

function render(){
 var app = document.getElementById('app');
 if(view === 'detail'){renderDetail();return;}
 renderHome();
}

function renderHome(){
 var h = '';
 // 顶部
 h += '<div class="card en-card"><div class="en-hero-top"><span class="dot"></span>每日英语 · 每天 1 片 · 应用验证</div></div>';

 // 今日任务
 var t = pickToday();
 h += '<div class="card en-card">';
 h += '<div class="card-h"><span class="ic">&#127757;</span>今日任务 <span style="font-size:11.5px;color:var(--sub);font-weight:400;margin-left:2px">'+t.order+' / '+EN_DATA.length+' 片</span></div>';
 h += '<div class="en-mini">';
 h += '<div class="en-body"><div class="en-name">'+esc(t.name)+' <span class="tag ts">'+esc(t.group)+'</span></div>';
 h += '<div class="en-meta">';
 if(!firstDate(t.order)) h += '<b style="color:#3fd6ab">今日首背</b>';
 else h += '上次 '+lastDate(t.order)+' · '+EN_LVL[lastLevel(t.order)];
 h += '</div></div>';
 h += '<div class="en-act"><button onclick="goDetail('+t.order+')">开始今日 1 片</button></div>';
 h += '</div></div>';

 // 分组列表
 var groups = {};
 EN_DATA.forEach(function(d){if(!groups[d.group])groups[d.group]=[];groups[d.group].push(d);});
 var orderArr = ['A-模板','B-语料'];
 orderArr.forEach(function(g){
  if(!groups[g])return;
  var list = groups[g];
  var done = list.filter(function(d){return firstDate(d.order);}).length;
  var mastered = list.filter(function(d){return lastLevel(d.order)>=4;}).length;
  h += '<div class="card"><div class="en-group-h">'+esc(g)+' <span class="g-cnt">'+done+'/'+list.length+' 已背 · '+mastered+' 已掌握</span></div><div class="en-list">';
  list.forEach(function(d){
   var l2 = lastLevel(d.order);
   var st='s0', stxt='未首背';
   if(l2){st = l2>=4?'s4':'s'+(l2<=2?'1':(l2===3?'3':'2')); stxt = EN_LVL[l2];}
   if(isDue(d.order) && firstDate(d.order)){st='due'; stxt='待复习';}
   h += '<div class="en-item" onclick="goDetail('+d.order+')"><span class="no">'+d.order+'</span><div class="mid"><div class="mn">'+esc(d.name);
   if(isDue(d.order) && firstDate(d.order)) h += ' <span class="tag td">待复习</span>';
   h += '</div><div class="mg">'+(firstDate(d.order)?('上次 '+lastDate(d.order)):'尚未首背')+'</div></div>';
   h += '<span class="st '+st+'">'+stxt+'</span><span class="arw">&#8594;</span></div>';
  });
  h += '</div></div>';
 });

 h += '<footer>英语模板与语料 · 严格按艾宾浩斯 + 应用验证排期</footer>';
 document.getElementById('app').innerHTML = h;
}

function renderDetail(){
 var d = EN_DATA.filter(function(x){return x.order===curOrder;})[0];
 if(!d){view='home';renderHome();return;}
 var l = lastLevel(d.order);
 var h = '';
 h += '<div class="back" onclick="goHome()">&#8592; 返回英语模块</div>';
 h += '<div class="card en-card">';
 h += '<div class="card-h"><span class="ic">&#127757;</span>'+esc(d.name)+' <span style="font-size:12px;color:var(--sub);font-weight:400;margin-left:6px">'+esc(d.group)+' · 第 '+d.order+'/'+EN_DATA.length+' 片</span></div>';
 h += '<div style="margin-bottom:12px"><span class="tag '+(d.group==='A-模板'?'ts':'td')+'">'+esc(d.group)+'</span>';
 if(firstDate(d.order)) h += ' <span class="tag tm">当前 '+EN_LVL[l]+'</span> <span style="font-size:12px;color:var(--sub)">上次 '+lastDate(d.order)+'</span>';
 else h += ' <span class="tag to">尚未首背</span>';
 if(isDue(d.order) && firstDate(d.order)) h += ' <span class="tag td">今日待复习</span>';
 h += '</div>';

 // 原文
 h += '<div class="en-box"><span class="lbl">模板 / 语料原文</span><div style="font-size:14.5px;line-height:1.95;white-space:pre-wrap">'+highlight(d.content)+'</div></div>';

 if(d.table){
  h += '<div class="en-box"><span class="lbl">功能表</span><div style="font-size:13px;line-height:1.8;white-space:pre-wrap">'+esc(d.table)+'</div></div>';
 }
 if(d.vocab && d.vocab.length){
  h += '<div class="en-box"><span class="lbl">语料清单</span><ul class="en-vocab">';
  d.vocab.forEach(function(v){h += '<li>'+esc(v)+'</li>';});
  h += '</ul></div>';
 }
 if(d.plug){
  h += '<div class="en-box"><span class="lbl">套用示范（可直接放进 P2 / P3）</span><div style="font-size:13.5px;line-height:1.9;white-space:pre-wrap">'+esc(d.plug)+'</div></div>';
 }
 if(d.memory){
  h += '<div class="en-box"><span class="lbl">记忆顺序</span><div style="font-size:13.5px;line-height:1.7">'+esc(d.memory)+'</div></div>';
 }
 if(d.rule){
  h += '<div class="en-box"><span class="lbl">替换 / 选择规则</span><div style="font-size:13.5px;line-height:1.7;white-space:pre-wrap">'+esc(d.rule)+'</div></div>';
 }
 if(d.notes){
  h += '<div class="en-box warn"><span class="lbl">&#9888; 使用注意（容易踩坑）</span><div style="font-size:13.5px;line-height:1.75;white-space:pre-wrap">'+esc(d.notes)+'</div></div>';
 }

 // 应用验证
 h += '<div class="en-prompt"><span class="lbl">&#128203; 应用验证</span><p>'+esc(d.prompt)+'</p></div>';

 // 自评
 h += '<div style="font-size:14px;font-weight:600;margin:20px 0 10px;padding-left:10px;border-left:3px solid var(--accent)">自评（点了就记录，复习间隔自动调整）</div>';
 h += '<div class="rate-btns">';
 h += '<button onclick="doMark(4)">&#128079; 想起来了<br><small>应用通过</small></button>';
 h += '<button class="b2" onclick="doMark(3)">&#128527; 有点印象</button>';
 h += '<button class="b4" onclick="doMark(2)">&#128561; 忘了</button>';
 h += '</div>';

 // 卡点备注
 h += '<div style="font-size:14px;font-weight:600;margin:22px 0 10px;padding-left:10px;border-left:3px solid var(--l3)">卡点备注 <span style="font-weight:400;font-size:12px;color:var(--sub)">输入后自动保存</span></div>';
 h += '<textarea class="note-box" id="enNoteBox" placeholder="这里记容易写错、容易忘的表达…" oninput="onNote(this.value)">'+(getNote(d.order)?esc(getNote(d.order)):'')+'</textarea>';

 // 导航上下片
 h += '<div class="en-marks" style="margin-top:18px"><button onclick="prevItem()">&#8592; 上一条</button><button onclick="nextItem()">下一条 &#8594;</button><button onclick="goHome()">返回列表</button></div>';

 h += '</div>';
 document.getElementById('app').innerHTML = h;
}

function highlight(s){
 return esc(s).replace(/\[([^\]]+)\]/g, '<span class="ph">[$1]</span>');
}

/* 交互 */
function goDetail(order){
 curOrder = order;
 view = 'detail';
 render();
 window.scrollTo(0,0);
}
function goHome(){
 view = 'home';
 render();
 window.scrollTo(0,0);
}
function doMark(level){
 markLevel(curOrder, level);
 toast(EN_LVL[level]+' · '+(level>=4?'7 天后抽查':'已安排近期复习'));
 renderDetail();
}
function onNote(val){
 setNote(curOrder, val);
}
function nextItem(){
 var idx = EN_DATA.map(function(d){return d.order;}).indexOf(curOrder);
 if(idx < EN_DATA.length-1){goDetail(EN_DATA[idx+1].order);}
 else toast('已经是最后一条');
}
function prevItem(){
 var idx = EN_DATA.map(function(d){return d.order;}).indexOf(curOrder);
 if(idx > 0){goDetail(EN_DATA[idx-1].order);}
 else toast('已经是第一条');
}

/* 启动 */
loadProgress();
render();
</script>
</body>
</html>
